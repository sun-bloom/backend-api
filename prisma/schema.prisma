generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  categoryNumber String   @unique
  description String
  image       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  subcategories Subcategory[]
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  slug       String
  categoryId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@unique([categoryId, slug])
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  basePrice   Float
  images      String[]
  isActive    Boolean   @default(true)
  productNumber String? @unique
  categoryId  String
  subcategoryId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category  @relation(fields: [categoryId], references: [id])
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  variants    Variant[]

  @@index([subcategoryId])
}

model Variant {
  id              String      @id @default(cuid())
  color           String
  pattern         String
  stock           Int
  additionalPrice Float       @default(0)
  variantNumber   String?
  sku             String      @unique
  images          String[]
  isAvailable     Boolean     @default(true)
  productId       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Customer {
  id             String         @id @default(cuid())
  firebaseUid    String?        @unique
  name           String
  email          String         @unique
  phone          String?        @unique
  whatsappNumber String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orders         Order[]
  supportQueries SupportQuery[]
  consultantRequests OrderConsultantRequest[]
  customerQueries CustomerQuery[]
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  status            OrderStatus   @default(PENDING)
  totalAmount       Float
  subtotal          Float?
  deliveryCharge    Float?
  deliveryAddress   String?
  city              String?
  state             String?
  pincode           String?
  deliveryRegionId  String?
  paymentMethod     String
  paymentStatus     PaymentStatus @default(PENDING)
  upiTransactionId  String?
  trackingCarrier   String?
  trackingNumber    String?
  trackingUrl       String?
  trackingRequested Boolean       @default(false)
  whatsappNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  customerId        String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  customer          Customer      @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  deliveryRegion    DeliveryRegion? @relation(fields: [deliveryRegionId], references: [id], onDelete: SetNull)
  customerQueries   CustomerQuery[]
}

model SupportQuery {
  id             String    @id @default(cuid())
  customerId     String?
  name           String
  phone          String
  whatsappNumber String?
  email          String
  queryType      String
  description    String
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float
  orderId   String
  variantId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   Variant @relation(fields: [variantId], references: [id])
}

model AdminUser {
  id           String    @id @default(cuid())
  firebaseUid  String?   @unique
  username     String    @unique
  email        String    @unique
  passwordHash String?
  role         String    @default("admin")
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Settings {
  id        String   @id @default(cuid())
  storeName String
  upiId     String
  upiName   String
  currency  String   @default("INR")
  updatedAt DateTime @updatedAt
}

model DeliverySettings {
  id                    String           @id @default(cuid())
  freeShippingThreshold Float            @default(999)
  defaultShippingCharge Float            @default(50)
  updatedAt             DateTime         @updatedAt
  regions               DeliveryRegion[]
}

model DeliveryRegion {
  id                 String           @id @default(cuid())
  regionName         String?
  pincode            String?
  pincodeStart       String?
  pincodeEnd         String?
  city               String
  state              String?
  shippingCharge     Float
  isActive           Boolean          @default(true)
  deliverySettingsId String
  deliverySettings   DeliverySettings @relation(fields: [deliverySettingsId], references: [id])
  orders             Order[]
}

model OrderConsultantRequest {
  id              String   @id @default(cuid())
  customerId      String?
  name            String
  phone           String
  whatsappNumber  String?
  email           String
  address         String
  city            String
  state           String
  pincode         String
  cartItems       Json?
  subtotal        Float?
  requestedRegion String?
  status          String   @default("NEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([pincode])
}

model PincodeZone {
  id      Int    @id @default(autoincrement())
  pincode String @unique
  zoneId  Int
  Zone    Zone   @relation(fields: [zoneId], references: [id])
}

model Zone {
  id             Int           @id @default(autoincrement())
  name           String
  deliveryCharge Int
  estimatedDays  Int
  codAvailable   Boolean       @default(true)
  PincodeZone    PincodeZone[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model CustomerQuery {
  id          String   @id @default(cuid())
  queryNumber String   @unique
  customerId  String
  orderId     String?
  category    String
  subject     String
  status      String   @default("OPEN")
  priority    String   @default("NORMAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages    CustomerQueryMessage[]

  @@index([customerId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
}

model CustomerQueryMessage {
  id         String   @id @default(cuid())
  queryId    String
  senderType String
  senderId   String?
  senderName String?
  message    String
  attachment String?
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  query      CustomerQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([createdAt])
}
